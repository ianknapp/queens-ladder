# Copy to .env.local after you create the Supabase project.
# Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the Mac collector sends when posting scores.
CAPTURE_SECRET=change-me-to-a-long-random-string

# Optional. If set, the site asks for this password before showing boards.
SITE_PASSWORD=

# Optional. Capture writes to Supabase directly when service-role keys are set.
# Keep this if you want a Vercel ingest fallback instead:
CAPTURE_INGEST_URL=http://localhost:3000/api/ingest
# After Vercel is live:
# CAPTURE_INGEST_URL=https://YOUR_VERCEL_APP.vercel.app/api/ingest

SUPABASE_PASSWORD=LinkedInGames123